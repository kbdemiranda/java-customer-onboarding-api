# ======================================================
# Customer Onboarding API - Environment Template
# Copy this file to .env and adjust values as needed.
# Example: cp .env.model .env
# ======================================================

# Runtime
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
DOCUMENT_STORAGE_BASE_PATH=/tmp/documents

# Database
POSTGRES_DB=customers_onboarding
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# External providers
WIREMOCK_PORT=8081
ZIP_CODE_WIREMOCK_BASE_URL=http://wiremock:8080
ZIP_CODE_VIACEP_BASE_URL=https://viacep.com.br/ws

# Image used by dev/prod compose files
APP_IMAGE=java-customer-onboarding-api:latest

# Images used by docker-compose.hub.yml
APP_IMAGE_HUB=kbdemiranda/java-customer-onboarding-api:latest
FRONTEND_IMAGE_HUB=kbdemiranda/react-customer-onboarding-web:latest
FRONTEND_PORT=3000
FRONTEND_API_BASE_URL=http://localhost:8080/api/v1
