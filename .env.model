# ======================================================
# Customer Onboarding API - Environment Template
# Copy this file to .env and adjust values as needed.
# Example: cp .env.model .env
# ======================================================

# Runtime
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database
POSTGRES_DB=customers_onboarding
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# External providers
WIREMOCK_PORT=8081
ZIP_CODE_WIREMOCK_BASE_URL=http://wiremock:8080
ZIP_CODE_VIACEP_BASE_URL=https://viacep.com.br/ws

# Image used by dev/prod compose files
APP_IMAGE=java-customer-onboarding-api:latest
